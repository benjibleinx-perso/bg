; Walter a pied.
;
; La capsule de collision fait 1,78 m comme le personnage.
;; Le maillage est le modele RIGGE livre par Guillaume : un vrai squelette de
; vingt-quatre os, avec ses animations de marche et de course. Il remplace le
; modele segmente que le projet animait par du code.
;
; La normalisation est faite par outils/importer_perso.py, qui met le
; personnage a 1,78 m, pose ses pieds a zero et le retourne — il arrivait face
; camera, donc marchait a reculons.
;
; Le corps genere reste dans assets/personnages/ : c'est lui qui habille les
; passants — passant_a, passant_b, passant_c — en attendant qu'ils aient leur
; propre modele rigge. walter.glb est sa version « Walter », gardee comme
; reference du generateur ; le jeu ne s'en sert plus.

[gd_scene load_steps=5 format=3 uid="uid://bgjoueur000001"]

[ext_resource type="Script" path="res://systemes/joueur.gd" id="1_joueur"]
[ext_resource type="Resource" path="res://systemes/reglages.tres" id="2_reglages"]
[ext_resource type="PackedScene" path="res://assets/personnages/walt.glb" id="3_walter"]

[sub_resource type="CapsuleShape3D" id="capsule"]
radius = 0.28
height = 1.78

[node name="Joueur" type="CharacterBody3D"]
collision_layer = 2
script = ExtResource("1_joueur")
reglages = ExtResource("2_reglages")

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.89, 0)
shape = SubResource("capsule")

; Le corps, RETOURNE d'un demi-tour.
;
; Le modele livre regarde vers +Z, c'est-a-dire face a la camera : il marchait
; donc a reculons. Le retourner a l'import ne suffit PAS — mesure faite : la
; rotation part bien dans le .glb, mais l'animation porte un canal sur le
; noeud racine et l'ecrase des la premiere image jouee.
;
; On le retourne donc ici, dans un noeud parent qu'aucune animation ne touche.
; ET REMONTE DE DIX-HUIT CENTIMETRES, mesures a l'appui (28/08/2026).
;
; « Walter a les pieds dans le sol, il faudrait le surelever legerement » —
; Guillaume, 27/08/2026. C'etait dix-huit centimetres, soit la cheville
; entierement enterree : verifs/diag_pieds.gd compare la hauteur de chaque
; cheville a celle qu'elle a dans la pose de repos, ou le modele est pose au
; sol par la chaine d'integration.
;
; CE QUI A DECIDE DE CORRIGER ICI PLUTOT QUE DANS LES ANIMATIONS : le BASSIN
; est enfonce d'autant que les pieds — 0,198 m contre 0,180 au repos. Des
; jambes flechies auraient donne l'inverse, un bassin bas et des pieds au sol.
; Tout le squelette est simplement pose trop bas, et les dix clips partagent le
; meme decalage, y compris ceux ou l'on saute ou l'on court. Un decalage commun
; se corrige une fois, au-dessus d'eux.
[node name="Corps" type="Node3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0.18, 0)

[node name="Walter" parent="Corps" instance=ExtResource("3_walter")]
