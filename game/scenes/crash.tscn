; LE SITE DU CRASH — le decor de la sequence A de « Deux corps, un camping-car ».
;
; Tout est ancre sur le lieu « fosse », publie par gen_desert.py. RIEN ICI NE
; PORTE DE COORDONNEE DU MONDE : la piste serpente, le fosse suit, et deux
; coordonnees recopiees a la main se sont deja retrouvees vingt-neuf metres a
; cote une fois. On s'ancre, on ne recopie pas.
;
; Le camping-car penche n'est PAS dans cette scene : desert.gd le pose lui-meme
; dans le fosse quand « accidente » est vrai, avec les trois angles trouves a
; l'image. Une seule facon de poser ce vehicule, un seul endroit ou la corriger.
;
; Les positions ci-dessous sont RELATIVES au fond du fosse. Elles ont ete
; posees a vue puis reglees a la capture — scenario « crash_site ».

[gd_scene load_steps=20 format=3 uid="uid://bgcrash0001"]

[ext_resource type="Script" path="res://systemes/ancrage.gd" id="1_ancrage"]
[ext_resource type="Script" path="res://systemes/point.gd" id="2_point"]
[ext_resource type="Script" path="res://systemes/pnj.gd" id="3_pnj"]
[ext_resource type="PackedScene" path="res://assets/personnages/jesse.glb" id="4_jesse"]
[ext_resource type="PackedScene" path="res://assets/personnages/emilio.glb" id="5_emilio"]
[ext_resource type="PackedScene" path="res://assets/personnages/krazy8.glb" id="6_krazy8"]
[ext_resource type="Script" path="res://systemes/passage.gd" id="7_passage"]
[ext_resource type="Script" path="res://systemes/dans_le_vehicule.gd" id="8_dedans"]
[ext_resource type="Script" path="res://systemes/pose_au_sol.gd" id="9_ausol"]
[ext_resource type="PackedScene" path="res://assets/objets/botte.glb" id="10_botte"]
[ext_resource type="PackedScene" path="res://assets/decor/bidons_chimie.glb" id="11_bidons"]
[ext_resource type="PackedScene" path="res://assets/decor/verrerie.glb" id="12_verrerie"]
