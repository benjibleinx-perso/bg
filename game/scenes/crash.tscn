evenement = "action:eteindre"
; JAMAIS CONSOMME. Un point « une fois » disparaitrait apres le premier essai,
; et le joueur en conclurait qu'il a reussi quelque chose. On doit pouvoir
; reessayer autant qu'on veut : c'est le seul moyen que l'echec se lise comme
; un echec plutot que comme une action manquee.
une_fois = false
; ENTRE LE RAYON QUI BRULE (1,9 m) ET CETTE PORTEE, il y a une bande ou l'on
; peut tenter sans se bruler. Sans elle, essayer d'eteindre exigerait d'entrer
; dans le feu, et le geste couterait de la vie a chaque appui.
portee = 2.8

