invite = "Ramasser le sac"
evenement = "objet:preuve"
donne = "sac_materiel"
etape_minimale = "preuve_1"
portee = 2.2
une_fois = true

[node name="G" parent="SacMateriel" instance=ExtResource("10_botte")]

