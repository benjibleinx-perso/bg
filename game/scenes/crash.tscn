; ------------------------------------------- CE QUI DIT QU'IL VIENT DE SE PASSER
; QUELQUE CHOSE
;
; Sans ca, on arrive de nuit devant un camping-car penche et rien ne raconte
; l'accident — « je ne comprends pas », premier essai. Le script nomme deux
; choses, et elles suffisent : la fumee du moteur, et les phares restes allumes.
;
; Les deux SUIVENT LE VEHICULE : ils sont sur le capot et dans les optiques
; d'une caisse qui pique du nez de neuf degres.
[node name="Fumee" type="Node3D" parent="."]
script = ExtResource("8_dedans")
decalage = Vector3(0, 1.3, 4.1)

[node name="P" type="GPUParticles3D" parent="Fumee"]
amount = 14
lifetime = 3.5
randomness = 0.6
visibility_aabb = AABB(-3, -1, -3, 6, 7, 6)
process_material = SubResource("fumee_proc")
draw_pass_1 = SubResource("fumee_quad")

; LES PHARES. Ils « eclairent la poussiere en suspension » selon le script — a
; defaut de poussiere volumetrique, ils eclairent le sable devant la caisse, et
; c'est ce qui se lit : deux faisceaux qui partent de travers dans le desert.
;
; Ils sont FROIDS et faibles. Une lumiere chaude et forte ferait « voiture garee
; qui attend » ; ce qu'on veut, c'est une machine restee allumee toute seule.
[node name="Phares" type="Node3D" parent="."]
script = ExtResource("8_dedans")
decalage = Vector3(0, 0.75, 4.6)

[node name="Gauche" type="SpotLight3D" parent="Phares"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.85, 0, 0)
light_color = Color(0.85, 0.88, 0.95, 1)
light_energy = 2.2
spot_range = 26.0
spot_angle = 28.0

[node name="Droite" type="SpotLight3D" parent="Phares"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.85, 0, 0)
light_color = Color(0.85, 0.88, 0.95, 1)
light_energy = 2.2
spot_range = 26.0
spot_angle = 28.0

; ------------------------------------------------------- OU LA PARTIE COMMENCE
;
; AU SOL, CONTRE LA PORTIERE OUVERTE — et c'est une simplification assumee.
;
; Le script demande « le joueur reprend la main a l'interieur, assis, masque a
; gaz sur le visage ». On ne peut pas encore : le camping-car du desert est un
; decor PLEIN, sa collision est une coque, et son interieur est une autre scene
; posee a neuf cents metres. Walter pose dedans traverse la tole et atterrit sur
; le sable — mesure au premier essai, 3,2 m de chute.
;
; Il se reveille donc DEHORS, contre la portiere grande ouverte que le script
; decrit, dans le fosse. Le masque se retire la. Ce qu'on perd : le tout premier
; plan a travers la vitre du masque, et la decouverte des corps depuis l'interieur.
;
; Ce qu'il faudra pour le rendre : un interieur du camping-car ACCIDENTE — le
; meme travail que la clairiere, et le meme ordre. La scene se joue et se regle
; d'abord ; le decor la remplacera sans toucher au deroule.
[node name="DepartCrash" type="Node3D" parent="."]
script = ExtResource("8_dedans")
decalage = Vector3(2.6, -0.4, 1.4)

; ------------------------------------------------------------------ LE MASQUE
;
; LE MASQUE EST SUR SON VISAGE, PAS A UN ENDROIT.
;
; Il etait un point pose contre le camping-car, avec deux metres de portee : il
; fallait donc MARCHER JUSQU'AU VEHICULE pour retirer quelque chose qu'on porte
; soi-meme. « Pourquoi je dois m'approcher du camping-car pour enlever le
; masque ? » — la question de Benjamin au premier essai, et elle n'a pas de bonne
; reponse.
;
; Il reste un point, parce que le joueur doit apprendre F ici et s'en servira
; pour tout le reste. Mais il est pose SUR le depart et porte a huit metres :
; ou qu'on aille dans le fosse, le geste est disponible tout de suite.
;
; La vraie forme viendra avec le filtre a l'ecran — vision teintee, respiration
; amplifiee — et ce jour-la il deviendra une touche a part entiere.
[node name="PointMasque" type="Node3D" parent="."]
script = ExtResource("8_dedans")
decalage = Vector3(2.6, -0.4, 1.4)

[node name="Point" type="Node3D" parent="PointMasque"]
script = ExtResource("2_point")
invite = "Retirer le masque"
evenement = "action:masque"
etape = "masque"
portee = 6.0
une_fois = true

; --------------------------------------------------------------------- JESSE
;
; Dehors, il fait les cent pas. Il se tait tant que le masque n'est pas retire :
; sa premiere replique est « Faut y aller MAINTENANT », et elle n'a aucun sens
; adressee a un homme encore assomme qui n'a pas dit un mot.
[node name="JesseAuSol" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.2, 0, 5.4)
script = ExtResource("9_ausol")

[node name="JesseCrash" type="Node3D" parent="JesseAuSol"]
script = ExtResource("3_pnj")
cle = "crash_panique"
geometrie = ExtResource("4_jesse")
etape_minimale = "reveil"

; ----------------------------------------------------- CE QU'ON NE LAISSE PAS
;
; Trois objets au sol, ramassables dans l'ordre qu'on veut. Le script insiste :
; l'objectif ne porte AUCUN chiffre — « Ne rien laisser derriere », et c'est au
; joueur de voir qu'il en reste.
;
; Ils sont poses assez loin les uns des autres pour qu'on ait a se deplacer, et
; assez pres du vehicule pour qu'on les trouve de nuit.
; CHACUN PORTE UN MODELE, et ce n'est pas un detail de finition.
;
; Les quatre etaient des noeuds NUS : aucune geometrie, rien a l'ecran. Le
; telephone disait « Ne rien laisser derriere » et il n'y avait rien a voir —
; Benjamin a tourne autour du camping-car en cherchant des objets invisibles,
; le 16/08/2026.
;
; C'est exactement le defaut de la latte descellee, deja paye une fois et ecrit
; dans monde.tscn : « une adresse exacte que rien ne signale n'est pas une
; adresse ». Un point d'interaction sans modele est une adresse.
;
; « pose_au_sol » les depose sur le sable quel que soit le relief : le fosse est
; publie a son FOND, et un objet a cinq metres du centre flottait ou s'enterrait
; de soixante-dix centimetres.
;
; HUIT METRES DU CENTRE, ET REPARTIS AUTOUR. Le camping-car fait neuf metres de
; long : la mallette etait posee a 2,7 m et le bidon a 4,0 — c'est-a-dire SOUS le
; vehicule. Benjamin n'a pu en ramasser que deux sur trois, et le troisieme
; n'etait pas introuvable, il etait inatteignable.
;
; Ils sont maintenant a huit metres, dans trois directions differentes : on doit
; faire le tour du fosse, ce qui est exactement ce que « ne rien laisser
; derriere » demande — chercher, et decider quand on a fini.
[node name="SacMateriel" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -7.5, 0, 3.0)
script = ExtResource("9_ausol")

[node name="Point" type="Node3D" parent="SacMateriel"]
