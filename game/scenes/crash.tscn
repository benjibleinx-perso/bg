; ------------------------------------------------------- OU LA PARTIE COMMENCE
;
; AU SOL, CONTRE LA PORTIERE OUVERTE — et c'est une simplification assumee.
;
; Le script demande « le joueur reprend la main a l'interieur, assis, masque a
; gaz sur le visage ». On ne peut pas encore : le camping-car du desert est un
; decor PLEIN, sa collision est une coque, et son interieur est une autre scene
; posee a neuf cents metres. Walter pose dedans traverse la tole et atterrit sur
; le sable — mesure au premier essai, 3,2 m de chute.
;
; Il se reveille donc DEHORS, contre la portiere grande ouverte que le script
; decrit, dans le fosse. Le masque se retire la. Ce qu'on perd : le tout premier
; plan a travers la vitre du masque, et la decouverte des corps depuis l'interieur.
;
; Ce qu'il faudra pour le rendre : un interieur du camping-car ACCIDENTE — le
; meme travail que la clairiere, et le meme ordre. La scene se joue et se regle
; d'abord ; le decor la remplacera sans toucher au deroule.
[node name="DepartCrash" type="Node3D" parent="."]
script = ExtResource("8_dedans")
decalage = Vector3(2.6, -0.4, 1.4)

; ------------------------------------------------------------------ LE MASQUE
;
; LE MASQUE EST SUR SON VISAGE, PAS A UN ENDROIT.
;
; Il etait un point pose contre le camping-car, avec deux metres de portee : il
; fallait donc MARCHER JUSQU'AU VEHICULE pour retirer quelque chose qu'on porte
; soi-meme. « Pourquoi je dois m'approcher du camping-car pour enlever le
; masque ? » — la question de Benjamin au premier essai, et elle n'a pas de bonne
; reponse.
;
; Il reste un point, parce que le joueur doit apprendre F ici et s'en servira
; pour tout le reste. Mais il est pose SUR le depart et porte a huit metres :
; ou qu'on aille dans le fosse, le geste est disponible tout de suite.
;
; La vraie forme viendra avec le filtre a l'ecran — vision teintee, respiration
; amplifiee — et ce jour-la il deviendra une touche a part entiere.
[node name="PointMasque" type="Node3D" parent="."]
script = ExtResource("8_dedans")
decalage = Vector3(2.6, -0.4, 1.4)

[node name="Point" type="Node3D" parent="PointMasque"]
script = ExtResource("2_point")
; ON LE RETIRE DE N IMPORTE OU. « L option "retirer le masque" n est cliquable
; que devant le RV. Elle devrait l etre depuis n importe ou. » — retour du
; 23/08/2026. Ce n est pas un objet pose dans le decor : c est quelque chose que
; Walter porte sur le visage.
invite = "Retirer le masque"
evenement = "action:masque"
etape = "masque"
partout = true
portee = 6.0
une_fois = true

; --------------------------------------------------------------------- JESSE
;
; Dehors, il fait les cent pas. Il se tait tant que le masque n'est pas retire :
; sa premiere replique est « Faut y aller MAINTENANT », et elle n'a aucun sens
; adressee a un homme encore assomme qui n'a pas dit un mot.
[node name="JesseAuSol" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.2, 0, 5.4)
script = ExtResource("9_ausol")

[node name="JesseCrash" type="Node3D" parent="JesseAuSol"]
script = ExtResource("3_pnj")
cle = "crash_panique"
geometrie = ExtResource("4_jesse")
; Il se taisait « a partir de reveil », l'etape qui envoyait regarder les corps.
; Elle n'existe plus — les corps sont sortis du suivi de mission — et c'est
; « jesse_panique » qui suit desormais le retrait du masque. Meme moment, meme
; silence avant : sa premiere replique est « Faut y aller MAINTENANT », et elle
; n'a aucun sens adressee a un homme encore masque.
etape_minimale = "jesse_panique"

; ----------------------------------------------------- CE QU'ON NE LAISSE PAS
;
; Trois objets au sol, ramassables dans l'ordre qu'on veut. Le script insiste :
; l'objectif ne porte AUCUN chiffre — « Ne rien laisser derriere », et c'est au
; joueur de voir qu'il en reste.
;
; Ils sont poses assez loin les uns des autres pour qu'on ait a se deplacer, et
; assez pres du vehicule pour qu'on les trouve de nuit.
; CHACUN PORTE UN MODELE, et ce n'est pas un detail de finition.
;
; Les quatre etaient des noeuds NUS : aucune geometrie, rien a l'ecran. Le
; telephone disait « Ne rien laisser derriere » et il n'y avait rien a voir —
; Benjamin a tourne autour du camping-car en cherchant des objets invisibles,
; le 16/08/2026.
;
; C'est exactement le defaut de la latte descellee, deja paye une fois et ecrit
; dans monde.tscn : « une adresse exacte que rien ne signale n'est pas une
; adresse ». Un point d'interaction sans modele est une adresse.
;
; « pose_au_sol » les depose sur le sable quel que soit le relief : le fosse est
; publie a son FOND, et un objet a cinq metres du centre flottait ou s'enterrait
; de soixante-dix centimetres.
;
; HUIT METRES DU CENTRE, ET REPARTIS AUTOUR. Le camping-car fait neuf metres de
; long : la mallette etait posee a 2,7 m et le bidon a 4,0 — c'est-a-dire SOUS le
; vehicule. Benjamin n'a pu en ramasser que deux sur trois, et le troisieme
; n'etait pas introuvable, il etait inatteignable.
;
; Ils sont maintenant a huit metres, dans trois directions differentes : on doit
; faire le tour du fosse, ce qui est exactement ce que « ne rien laisser
; derriere » demande — chercher, et decider quand on a fini.
[node name="SacMateriel" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -7.5, 0, 3.0)
script = ExtResource("9_ausol")

[node name="Point" type="Node3D" parent="SacMateriel"]
script = ExtResource("2_point")
invite = "Ramasser le sac"
evenement = "objet:preuve"
surbrillance = true
donne = "sac_materiel"
etape_minimale = "preuve_1"
portee = 2.2
une_fois = true

[node name="G" parent="SacMateriel/Point" instance=ExtResource("10_sac")]

[node name="BidonRenverse" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 7.5, 0, 2.5)
script = ExtResource("9_ausol")

[node name="Point" type="Node3D" parent="BidonRenverse"]
script = ExtResource("2_point")
invite = "Ramasser le bidon"
evenement = "objet:preuve"
surbrillance = true
donne = "bidon_renverse"
etape_minimale = "preuve_1"
portee = 2.2
une_fois = true

; SANS ROTATION : LE MODELE EST DEJA COUCHE.
;
; Il l'a ete pendant deux jours par une rotation de quatre-vingt-dix degres, et
; ce qu'elle couchait n'etait meme pas un bidon renverse : c'etait le meuble a
; bidons du labo, DEUX futs debout, recycle tel quel. « Un bidon renverse » —
; les mots du battement A5 — est maintenant un objet a lui, un jerrican sur le
; flanc, bouchon devisse et coulure sombre.
[node name="G" parent="BidonRenverse/Point" instance=ExtResource("11_bidons")]

[node name="VerrerieCassee" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5.0, 0, -6.5)
script = ExtResource("9_ausol")

[node name="Point" type="Node3D" parent="VerrerieCassee"]
script = ExtResource("2_point")
invite = "Ramasser la verrerie"
evenement = "objet:preuve"
surbrillance = true
donne = "verrerie_cassee"
etape_minimale = "preuve_1"
portee = 2.2
une_fois = true

; UN BALLON BRISE, ET SES ECLATS AUTOUR. C'etait jusqu'ici verrerie.glb — la
; verrerie INTACTE de la paillasse du labo, posee dans le sable. Le battement A5
; demande « un eclat de verrerie cassee », et deux des trois objets a ramasser
; etaient en fait du mobilier de laboratoire recycle.
[node name="G" parent="VerrerieCassee/Point" instance=ExtResource("12_verrerie")]

; ------------------------------------------------------------------ LE PANTALON
;
; Il s'envole a l'ouverture et retombe plus loin que les trois autres — assez
; pour qu'on doive le vouloir. C'est le seul objet du jeu qui traverse quinze
; missions : ramasse ici, il ressort plie sur la banquette arriere au generique.
;
; Le joueur qui court ne le prendra pas, et c'est exactement le but. Voir #67.
; « etape_minimale » ET NON « etape » : il apparait a ce moment-la et NE
; DISPARAIT PLUS. Avec « etape », il s'evanouissait a la seconde ou son etape
; etait sautee — c'est-a-dire exactement quand elle devient facultative. Le
; joueur qui revient sur ses pas doit pouvoir le ramasser encore.
;
; VINGT-SIX METRES, ET IL N'EN FAISAIT QUE ONZE.
;
; « Deja, le mettre beaucoup plus loin du RV, il est trop facile a trouver ici.
; Ensuite, retirer cette etape du suivi de mission. Si le joueur le trouve, il
; peut le ramasser, mais s'il ne le ramasse pas, la mission continue
; normalement. » — retour du 23/08/2026.
;
; Il etait a onze metres, dans l'axe des trois preuves : on le voyait en
; ramassant la verrerie, et son etape facultative arrivait juste apres les
; trois autres. Autant dire un quatrieme objet obligatoire avec un objectif de
; plus dans le telephone — ce que la version 0.56.0 en avait fait par erreur, et
; qui revenait par la porte du deroule apres avoir ete corrige dans le code.
;
; VINGT-SIX METRES, C'EST LE HAUT DE LA PENTE : hors du cercle qu'on parcourt
; en ramassant, dans une direction ou rien d'autre n'appelle. On ne le trouve
; qu'en decidant de chercher, et c'est la blague de la serie qui l'exige.
;
; SON ETAPE N'EXISTE PLUS : « etape_minimale = preuve_1 » le fait apparaitre
; quand le ramassage commence, et il reste la jusqu'a la fin de la sequence. Le
; joueur qui remonte sans lui ne saura jamais qu'il etait la — sauf si Jesse le
; lui fait remarquer, ce qui est le sujet du choix a la fin du ramassage.
[node name="Pantalon" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 9.0, 0, -24.5)
script = ExtResource("9_ausol")

[node name="Point" type="Node3D" parent="Pantalon"]
script = ExtResource("2_point")
invite = "Ramasser le pantalon"
evenement = "objet:pantalon"
surbrillance = true
donne = "pantalon"
etape_minimale = "preuve_1"
portee = 2.2
une_fois = true

; COUCHE SUR LE FLANC — quatre-vingt-dix degres autour de Z.
;
; Le modele est un pantalon EN VOLUME, debout, une jambe pliee : c'est ce que
; rend la generation, et c'est tant mieux — un pantalon jete garde sa forme, il
; ne s'aplatit pas comme une serpillere. Couche sur le flanc il fait 85 cm de
; long pour 37 de haut, ce qui est un vetement tombe ; couche sur le dos il en
; ferait 75 de haut, ce qui est un tas.
;
; « Il est moche et on comprend pas ce que c'est » a ete diagnostique quatre fois
; de travers — la blouse de laboratoire qui en tenait lieu, un modele taille en
; boites, une rotation qui le mettait debout, puis un modele genere en tas trop
; compact. C'est l'objet le plus cher du projet, et rien de tout cela ne se
; voyait ailleurs que sur une image.
[node name="G" parent="Pantalon/Point" instance=ExtResource("13_pantalon")]
transform = Transform3D(0, 1, 0, -1, 0, 0, 0, 0, 1, 0, 0.19, 0)

; ------------------------------------------------------------- ON REMONTE
;
; IL N'Y A PLUS RIEN A CLIQUER ICI, ET C'ETAIT LE DEFAUT DU BATTEMENT.
;
; Un point nomme PointRemonter se tenait a quatre metres de la portiere, avec
; l'invite « Ecouter ». Le joueur devait donc marcher jusqu'a un endroit precis
; et appuyer sur E pour avoir le droit d'entendre une sirene qui hurlait deja.
;
; « Enlever l'action de "ecouter", ca ne devrait pas etre une etape cliquable,
; mais un dialogue lance automatiquement, des la recolte du 3eme objet
; important. Pendant ce dialogue, le joueur peut toujours jouer. » — retour du
; 23/08/2026.
;
; La conversation est passee dans le champ « dit » de l'etape « remonter » du
; fichier de mission : elle part a la seconde ou le troisieme objet est en
; poche, ou que le joueur se trouve, et elle ne fige personne. L'etape se
; franchit maintenant en s'asseyant au volant, ce qui est ce que son objectif
; demande depuis toujours.

; -------------------------------------------------------------- LE DEMARRAGE
;
; Le moteur tousse. Le script est formel : jamais plus de trois essais, parce
; que c'est le tout premier geste de conduite du jeu et qu'il doit etre
; infaillible.
;
; Le nombre est tire entre 2 et 3 au premier appui — jamais 1, un moteur qui
; part du premier coup ne raconte rien. Un essai rate ne consomme pas le point :
; il rend son message comme un refus ordinaire, et le point se represente. Le
; mecanisme etait deja dans point.gd, il n'a fallu qu'un compteur.
;
; La hauteur du bruit fait tout le travail : c'est le demarreur du jeu, joue a
; 0.62 — un demarreur qui peine est un demarreur qui tourne moins vite. Sans
; son, « ca n'a pas marche » et « la touche n'a rien fait » se ressemblent
; trop, et le joueur arrete d'appuyer.
; -------------------------------------------- LE TRAJET QU'ON FAIT A L'AVEUGLE
;
; « Il nous indique plus ou moins des directions, que le joueur doit suivre pour
; avancer dans le script. Avancer, Tourner a droite, l'autre droite (gauche, car
; il s'est trompe de panique) Puis il propose a Walter d'enlever le masque.
; C'est la qu'on voit le decor. » — retour du 23/08/2026.
;
; TROIS JALONS, ET LEUR PLACE EST LA MISE EN SCENE ENTIERE. On part contre la
; portiere, cote X positif. Le trajet doit :
;
;   1. ELOIGNER — sinon « avancez » ne veut rien dire et on se cogne au
;      camping-car des le premier pas ;
;   2. TOURNER DEUX FOIS, une fois a droite et une fois a gauche, parce que
;      c'est la blague : Jesse se trompe, se corrige, et cette seconde-la est
;      tout ce qu'on retient de la scene ;
;   3. RAMENER FACE A LA CAISSE sans qu'on l'ait vue venir.
;
; Les trois angles sont donc contraints, et ils se mesurent : la suite
; « ouverture » verifie que le virage de GuideDeux part bien vers la droite du
; joueur et celui de GuideTrois vers sa gauche. Une consigne ecrite dans le
; fichier de mission et une geometrie qui dit l'inverse, c'est un joueur qui
; tourne dans le vide en croyant s'etre trompe — et il n'y voit rien pour
; verifier.
;
; ILS NE PORTENT AUCUNE GEOMETRIE. On ne doit rien voir : ce sont des adresses,
; pas des objets. C'est le seul endroit du jeu ou un point d'interet invisible
; est la bonne reponse, precisement parce que le joueur ne regarde pas — il
; ecoute.

; Droit devant, en s'eloignant de la caisse. « Par ici, Mr. White ! »
[node name="GuideUn" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 15.0, 0, 6.0)
script = ExtResource("9_ausol")

; A DROITE, et c'est la vraie droite. Depuis GuideUn, en regardant vers le large
; du desert, ce jalon-ci est du bon cote.
[node name="GuideDeux" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 9.0, 0, 10.0)
script = ExtResource("9_ausol")

; « L'AUTRE DROITE ! » — c'est-a-dire a gauche, et ca ramene vers le
; camping-car. Le dernier pas se fait donc en direction de la caisse, qu'on ne
; voit toujours pas, et on s'arrete a une dizaine de metres d'elle : assez pour
; qu'elle tienne dans le cadre quand le masque tombe.
[node name="GuideTrois" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6.0, 0, 16.0)
script = ExtResource("9_ausol")

[node name="Guidage" type="Node3D" parent="."]
script = ExtResource("20_guidage")
jalons = [NodePath("../GuideUn"), NodePath("../GuideDeux"), NodePath("../GuideTrois")]
; ON REGARDE LA PORTIERE, pas le centre du vehicule : c'est le cote ouvert, et
; c'est ce qui raconte qu'on en est sorti. « DepartCrash » suit le camping-car,
; donc ce cap reste juste si l'on change son angle.
face_a = NodePath("../DepartCrash")
rayon = 4.0

; ---------------------------------------------------- ON NE LES LAISSE PAS LA
;
; Le mecanisme qui porte les deux corps jusqu'a la portiere. Il ne fait rien
; tant que l'etape courante ne dit pas « traction »: true — voir systemes/
; traction.gd, et le fichier de la mission pour l'etape qui le declare.
;
; LA PORTE EST « DepartCrash », ET CE N'EST PAS UN HASARD DE NOMMAGE. C'est
; l'endroit ou Walter se reveille contre la portiere ouverte, donc l'entree du
; camping-car, et c'est un noeud qui SUIT LE VEHICULE. Une coordonnee ecrite ici
; serait juste tant que la caisse ne bouge pas, et fausse le jour ou l'on
; changera son angle de trois degres.
;
; LES DEUX CORPS SONT DESIGNES UN PAR UN plutot que ramasses par leur parent :
; « CorpsALArriere » porte aussi le point « Regarder », et un mecanisme qui
; ramasserait tous les enfants d'un noeud finirait par trainer une invite
; d'interaction dans le sable.
[node name="Traction" type="Node3D" parent="."]
script = ExtResource("19_traction")
corps = [NodePath("../CorpsALArriere/Krazy8"), NodePath("../CorpsALArriere/Emilio")]
porte = NodePath("../DepartCrash")
aide = NodePath("../JesseAuSol/JesseCrash")
; ON VA JUSQU A LA PORTIERE, pas jusqu a trois metres d elle. Le rayon valait
; 2,6 m et le corps se traine 1,15 m derriere Walter : il deposait donc son
; cadavre en s arretant a pres de quatre metres du camping-car, ce qui se lit
; comme un objet qui disparait tout seul.
depot = 2.0

; LE PREMIER TOUR DE CLE, CELUI QUI NE DEMARRE RIEN.
;
; « JUSTE au moment d essayer de demarrer le RV pour la premiere fois (bruit de
; moteur qui ne demarre pas), l un des deux personnage lance un dialogue (stop
; le RV aussi) "ATTEND !.. les corps... on peut pas les laisser la non plus.. –
; Putain... allez vient m aider !" » — retour du 23/08/2026.
;
; UN POINT SEPARE, ET PAS UN DRAPEAU SUR CELUI D EN DESSOUS. Les deux gestes se
; font au meme endroit et se distinguent par l etape ou l on est : c est
; exactement ce que le champ « etape » de point.gd sait faire. Un seul point qui
; changerait de sens selon le moment demanderait au code de savoir ou en est la
; mission, et c est ce qu on evite partout ailleurs.
;
; Il porte un evenement au lieu d armer le demarreur : le mini-jeu n a rien a
; faire ici, il vient deux etapes plus loin, une fois les corps a bord.
[node name="PosteContact" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, 1.2, -2.8)
script = ExtResource("2_point")
invite = "Mettre le contact"
evenement = "action:contact"
etape = "contact"
au_volant = true
portee = 2.2
une_fois = true

[node name="PosteConduite" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, 1.2, -2.8)
script = ExtResource("2_point")
; « Demarrer » ET NON « Mettre le contact » : la cle est deja tournee depuis
; qu il existe un point pour ca, deux etapes plus haut. Deux invites
; identiques a deux moments differents feraient croire qu on refait le meme
; geste — et qu il n a servi a rien la premiere fois.
invite = "Demarrer"
; IL N ARME LE DEMARREUR, IL NE DEMARRE PLUS RIEN.
;
; Ce point portait « action:demarrer » et un compteur d essais : on appuyait
; deux ou trois fois, un bandeau annoncait que le moteur toussait, et ca
; partait. « Ne PAS ecrire "le moteur tousse" par pitie, il faut le vivre, pas
; le lire » — retour du 23/08/2026.
;
; C est desormais systemes/demarreur.gd qui tient le geste, et c est SA
; reussite qui emet l evenement. Le point ne fait plus qu ouvrir le contact.
;
; L ETAPE « demarrer » COMMENCE MAINTENANT AU TROISIEME OBJET, et c est ce qui
; rend ce point atteignable.
;
; On ne monte dans une epave gelee que s il y a un geste de tableau de bord qui
; attend — c est ecrit dans le controleur, et c est juste : sans ce garde, la
; portiere s ouvrait des le reveil sous le masque. Ce geste, c est CE point.
;
; Il y avait ici une etape « remonter » entre le ramassage et le demarrage, et
; elle rendait la portiere infranchissable : il fallait etre a l etape suivante
; pour pouvoir monter, et monter pour quitter celle-la. Les deux etapes n en
; font plus qu une — voir _note_fusion dans le fichier de mission.
etape = "demarrer"
; ASSIS AU VOLANT, ET NULLE PART AILLEURS. C'etait un point ordinaire, donc on
; pouvait tourner la cle debout dans le sable, derriere le vehicule.
au_volant = true
portee = 2.2
une_fois = true


; LE MINI-JEU DU DEMARRAGE. Il ecoute le poste de conduite : mettre le contact
; l arme, tenir la touche ouvre le cadran, et c est sa reussite qui emet
; l evenement que la mission attend.
;
; Il vit ICI, dans la scene du crash, et pas dans le monde : ce cadran n a de
; sens qu au fond de ce fosse. Le jour ou un autre vehicule refusera de
; demarrer, il aura le sien.
[node name="Demarreur" type="Node" parent="."]
script = ExtResource("17_demarreur")
poste = NodePath("../PosteConduite")
; Le chemin est indicatif : le demarreur retrouve l interface tout seul si le
; decor a ete instancie ailleurs dans l arbre, ce que fait desert.gd.
interface = NodePath("../../../../Interface/Echelle")

; Le moteur a pris. Jesse tape le tableau de bord — deuxieme point au meme
; endroit, actif seulement une fois le demarrage passe.
[node name="PointMoteurLance" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, 1.2, -2.8)
script = ExtResource("2_point")
invite = "Se remettre en route"
dialogue = "crash_moteur"
etape = "moteur_lance"
; AU VOLANT, COMME LE DEMARRAGE JUSTE AVANT.
;
; Jesse tape le tableau de bord en criant « Allez, allez, ALLEZ— » : il est assis
; a cote, le moteur vient de prendre, et personne ne descend entre les deux.
; Sans ce champ il fallait RESSORTIR du camping-car pour declencher la replique
; puis y remonter — « c'est absurde », et ca l'est.
au_volant = true
portee = 2.2

; ------------------------------------------------------ LA SORTIE DE LA ZONE
;
; Le script veut « une sortie de zone balisee par un repere visuel — panneau,
; crete — et pas de fleche de direction a l'ecran ». Le passage est donc large
; et pose sur la crete : on le franchit en roulant, sans le chercher.
;
; IL EMMENE A LA CLAIRIERE, et c'est le fondu du battement A9. La destination
; est le seul endroit de cette scene qui porte une coordonnee du monde : un
; passage doit dire ou il mene, et la clairiere s'ancre ailleurs.
; LE REPERE VISUEL, ET IL MANQUAIT.
;
; A8, mot pour mot : « conduite libre sur la piste jusqu'a UN REPERE VISUEL (une
; crete, UN PANNEAU A MOITIE ENSEVELI). Pas de HUD directionnel. »
;
; La zone existait, large de trente metres, et rien ne la signalait. A pied on
; finit par tomber dessus en cherchant ; au volant on passe a cote sans savoir
; ou viser — « ca declenche le trois semaines plus tot uniquement a pied ».
;
; Le script refuse explicitement une fleche a l'ecran : ce qui doit guider, c'est
; le DECOR. Le panneau du desert existe deja dans le jeu ; il est ici penche et
; enfonce jusqu'a mi-hauteur, comme le script le decrit.
;
; Deux, de part et d'autre de la piste : un seul se contourne sans le voir, et
; on ne saurait pas qu'il marque un passage plutot qu'un bord de route.
; SUR LA PISTE, ET C'EST CALCULE.
;
; Le fosse est A COTE de la piste — gen_desert.py le pose a « piste_x(y) + 21 »
; — et cette scene est ancree sur le FOSSE. Une sortie posee a x = 0 tombait
; donc vingt-et-un metres a cote de la chaussee, en plein sable : « y'a ecrit
; sortir par le chemin mais le point est meme pas sur le chemin ».
;
; La piste serpente (26 * sin(y / 95)), donc l'ecart n'est pas constant : a
; vingt-six metres au nord du fosse elle passe a x = -21,32 dans ce repere. Le
; nombre est CALCULE a partir du generateur, pas releve a l'oeil — c'est la
; meme fonction qui dessine la route et qui place ce passage.
;
; A8 dit « conduite libre SUR LA PISTE jusqu'a un repere visuel » : la piste est
; le chemin, et le repere doit etre dessus.
[node name="RepereGauche" type="Node3D" parent="."]
transform = Transform3D(0.94, 0, -0.34, 0, 1, 0, 0.34, 0, 0.94, -32.3, -0.9, -26)
script = ExtResource("9_ausol")
decalage = -0.9

[node name="G" parent="RepereGauche" instance=ExtResource("16_panneau")]

[node name="RepereDroit" type="Node3D" parent="."]
transform = Transform3D(0.87, 0, 0.5, 0, 1, 0, -0.5, 0, 0.87, -10.3, -1.2, -26)
script = ExtResource("9_ausol")
decalage = -1.2

[node name="G" parent="RepereDroit" instance=ExtResource("16_panneau")]

[node name="SortieCrash" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -21.3, 1.5, -26)
collision_layer = 0
collision_mask = 7
script = ExtResource("7_passage")
; LA CLAIRIERE, en coordonnees du monde. C est le seul endroit de cette scene
; qui en porte, et un passage ne peut pas faire autrement : il doit dire ou il
; mene, et la clairiere s ancre derriere une mesa. PAS a neuf cents metres, comme
; ce commentaire l a longtemps affirme : 96,6 m entre cette zone et le point
; d arrivee, mesures le 23/08/2026. En camping-car, c est quelques secondes — et
; c est pour ca que cette zone se referme une fois franchie.
; Calcule et non devine : desert (900,0,-900) + mesa_3 (-88,6.5,178) + decalage
; de la clairiere (34,-6.5,18), moins un retrait pour arriver face au decor.
; ELLE VISE UN NOEUD DE LA CLAIRIERE, ET PLUS UNE COORDONNEE.
;
; Le calcul ci-dessus tombait juste — trois metres du camping-car, mesures. Mais
; il additionne trois valeurs dont DEUX appartiennent a un decor genere : il est
; exact tant que rien ne bouge, et rien ne signalera le jour ou quelque chose
; bouge. Viser « ArriveeFlashback » supprime la question, et le point se deplace
; avec la clairiere puisqu'il lui appartient.
;
; La coordonnee reste comme filet : si le noeud disparaissait, mieux vaut
; atterrir au mauvais endroit qu'a l'origine du monde.
destination = Vector3(843, 1, -708)
destination_vers = "ArriveeFlashback"
; TROIS SEMAINES PLUS TOT NE SE FRANCHIT PAS EN VOITURE. On descend avant le
; fondu, et le camping-car accidente reste dans le desert — sans quoi il se gare
; a cote de celui du flashback, et Guillaume en voit deux dans la meme vue.
a_pied = true
cap_degres = 200.0
; LE RETOURNEMENT DU BATTEMENT A9. La conversation existait, doublee, et rien ne
; pouvait la lancer : elle attendait un declencheur a l'entree de zone, et c'est
; le JSON de la mission qui le disait lui-meme. C'est desormais un champ du
; passage — on arrive, on voit ou l'on est, et Jesse parle.
dialogue = "crash_pompiers"
; TROIS SEMAINES PLUS TOT, ET EN PLEIN JOUR. Le script decrit la sequence B
; comme « desert, jour, chaleur, lumiere crue ». On franchissait la crete a
; 21h30 et on cuisinait dans le noir.
heure = 13.5
; LE SAUT DE TROIS SEMAINES SE DIT SUR DU NOIR, pas dans un bandeau de tuto.
; Il etait annonce en haut a gauche, de la meme forme que « E pour interagir » —
; c est-a-dire de la meme forme qu une consigne de touche.
carton = "Trois semaines plus tot"
; TROIS SECONDES DE CONDUITE SUR LA PISTE, ET LA SCENE PART.
;
; « Le mieux serait de declencher une cinematique des qu on se trouve les 4
; roues sur la route et qu on roule pendant au moins 3 secondes. » Il n y a plus
; de ligne a franchir : on monte, on roule, ca part. Personne ne cherche ou est
; la limite, parce qu il n y en a plus.
roule_depuis = 3.0
vitesse_minimale = 8.0
zone = "sortie_crash"
exige_vehicule = false
etape_minimale = "moteur_lance"
refus_etape = "Il reste quelque chose a faire ici"
; ET ELLE SE REFERME UNE FOIS FRANCHIE. Masquer le decor du fosse ne desactive
; pas cette zone — Godot ne coupe que le rendu. Elle est a 96 metres de la
; clairiere, mesures : en camping-car on y revient en quelques secondes, et tout
; se rejouait — le fondu, la teleportation, le carton, et le dialogue des
; pompiers. C est la derniere piece du bug du 23/08/2026.
etape_maximale = "sortir_du_fosse"

[node name="Forme" type="CollisionShape3D" parent="SortieCrash"]
shape = SubResource("forme_sortie")
